ANALYTICS_DB_USER=analytics_readonly
ANALYTICS_DB_PASSWORD=analytics_readonly_local_dev
# Ключ провайдера LLM (Anthropic/OpenAI и т.д. — провайдер спрятан за internal/llm.Client,
# см. docs/api-architecture.md). Значение — placeholder, реальный ключ каждый разработчик
# подставляет сам в свой .env (не .env.example, он в .gitignore).
LLM_API_KEY=
