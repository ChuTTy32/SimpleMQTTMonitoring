POSTGRES_USER=mqtt_monitor
POSTGRES_PASSWORD=mqtt_monitor_local_dev
POSTGRES_DB=mqtt_monitoring

# REST API (api/) — internal/config/config.go, см. docs/api-architecture.md
DB_DSN=postgres://mqtt_monitor:mqtt_monitor_local_dev@db:5432/mqtt_monitoring?sslmode=disable
JWT_SECRET=local_dev_jwt_secret_change_me
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# LLM Analytics (api/internal/analytics) — read-only роль, создаётся миграцией
# db/migrations/000002_llm_analytics_readonly.up.sql, см. docs/api-architecture.md.
ANALYTICS_DB_USER=analytics_readonly
ANALYTICS_DB_PASSWORD=analytics_readonly_local_dev
# Ключ провайдера LLM (Anthropic/OpenAI и т.д. — провайдер спрятан за internal/llm.Client,
# см. docs/api-architecture.md). Значение — placeholder, реальный ключ каждый разработчик
# подставляет сам в свой .env (не .env.example, он в .gitignore).
LLM_API_KEY=
